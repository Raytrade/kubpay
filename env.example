# KubPay server
PORT=8080

# PostgreSQL
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/kubpay?sslmode=require

# JWT signing secret
JWT_SECRET=replace-with-a-long-random-secret

# Paystack
PAYSTACK_SECRET_KEY=sk_test_replace_me

# Payout controls
PAYOUT_REQUIRE_APPROVAL=true

# ₦50,000 maximum per transfer = 5,000,000 kobo
MAX_TRANSFER_KOBO=5000000

# ₦50,000,000 daily maximum = 5,000,000,000 kobo
DAILY_TRANSFER_KOBO=5000000000
