// Helpers
// ------------------------------------------------------------

func providerTransferStatus(
	response PaystackResponse,
) string {

	data, ok :=
		response["data"].(map[string]any)

	if !ok {
		return ""
	}

	status, _ :=
		data["status"].(string)

	return status
}

func nonEmptyReason(
	value string,
) string {

	value = strings.TrimSpace(value)

	if value == "" {
		return "KubPay transfer"
	}

	return value
}

func mustJSON(
	value any,
) []byte {

	data, err := json.Marshal(value)

	if err != nil {
		return []byte(`{}`)
	}

	return data
}
