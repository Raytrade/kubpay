func (a *App) resolveAccount(c *gin.Context) {
	bankCode := strings.TrimSpace(
		c.Query("bank_code"),
	)

	accountNumber := strings.TrimSpace(
		c.Query("account_number"),
	)

	if bankCode == "" ||
		len(accountNumber) != 10 {

		c.JSON(
			http.StatusBadRequest,
			gin.H{
				"error":
					"bank_code and 10-digit account_number required",
			},
		)
		return
	}

	query := url.Values{}

	query.Set(
		"account_number",
		accountNumber,
	)

	query.Set(
		"bank_code",
		bankCode,
	)

	result, _, err := a.paystackRequest(
		c.Request.Context(),
		http.MethodGet,
		"/bank/resolve?"+query.Encode(),
		nil,
	)

	if err != nil {
		c.JSON(
			http.StatusUnprocessableEntity,
			gin.H{
				"error":
					"account could not be resolved",
				"provider": result,
			},
		)
		return
	}

	c.JSON(http.StatusOK, result)
}

