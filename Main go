type App struct {
	db *pgxpool.Pool
}

type Claims struct {
	UserID string `json:"user_id"`
	Role   string `json:"role"`
	jwt.RegisteredClaims
}

type PaystackResponse map[string]any

func main() {
	_ = godotenv.Load()

	ctx := context.Background()

	databaseURL := mustEnv("DATABASE_URL")

	db, err := pgxpool.New(ctx, databaseURL)
	if err != nil {
		log.Fatal("database connection failed: ", err)
	}
	defer db.Close()

	if err := db.Ping(ctx); err != nil {
		log.Fatal("database ping failed: ", err)
	}

	app := &App{
		db: db,
	}

	router := gin.New()

	router.Use(
		gin.Logger(),
		gin.Recovery(),
	)

	router.GET("/", func(c *gin.Context) {
		c.File("./web/index.html")
	})

	router.GET("/health", func(c *gin.Context) {
		c.JSON(http.StatusOK, gin.H{
			"status":  "ok",
			"service": "kubpay",
		})
	})

	router.GET("/ready", func(c *gin.Context) {
		if err := app.db.Ping(c.Request.Context()); err != nil {
			c.JSON(http.StatusServiceUnavailable, gin.H{
				"ready": false,
			})
			return
		}

		c.JSON(http.StatusOK, gin.H{
			"ready": true,
		})
	})

	// Public authentication.
	router.POST("/api/v1/auth/register", app.register)
	router.POST("/api/v1/auth/login", app.login)

	// Paystack webhook.
	router.POST("/webhooks/paystack", app.paystackWebhook)

	// Authenticated customer API.
	api := router.Group("/api/v1")
	api.Use(app.authMiddleware())

	api.GET("/me", app.me)
	api.GET("/balance", app.balance)

	api.GET("/banks", app.banks)
	api.GET("/resolve-account", app.resolveAccount)

	api.POST("/payouts", app.createPayout)
	api.GET("/payouts", app.listPayouts)

	api.GET("/transactions", app.transactions)

	// Founder/admin API.
	admin := router.Group("/api/v1/admin")
	admin.Use(
		app.authMiddleware(),
		requireAdmin,
	)

	admin.POST("/payouts/:id/approve", app.approvePayout)
	admin.POST("/payouts/:id/reject", app.rejectPayout)

	port := env("PORT", "8080")

	log.Printf("KubPay listening on :%s", port)

	if err := router.Run(":" + port); err != nil {
		log.Fatal(err)
	}
}

// ------------------------------------------------------------
// Environment helpers
// ------------------------------------------------------------

func env(key, fallback string) string {
	value := os.Getenv(key)

	if value == "" {
		return fallback
	}

	return value
}

func mustEnv(key string) string {
	value := os.Getenv(key)

	if value == "" {
		log.Fatalf("missing required environment variable: %s", key)
	}

	return value
}

func envInt64(key string, fallback int64) int64 {
	value := os.Getenv(key)

	if value == "" {
		return fallback
	}

	n, err := strconv.ParseInt(value, 10, 64)
	if err != nil {
		log.Fatalf("invalid integer environment variable %s", key)
	}

	return n
}

