// Payout creation
// ------------------------------------------------------------

type payoutRequest struct {
	BankCode      string `json:"bank_code"`
	AccountNumber string `json:"account_number"`
	AmountKobo    int64  `json:"amount_kobo"`
	Reason        string `json:"reason"`
}

func (a *App) createPayout(c *gin.Context) {
	userID, err := currentUserID(c)

	if err != nil {
		c.JSON(http.StatusUnauthorized, gin.H{
			"error": "invalid user",
		})
		return
	}

	var input payoutRequest

	if err := c.ShouldBindJSON(&input); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "invalid payout request",
		})
		return
	}

	input.BankCode = strings.TrimSpace(
		input.BankCode,
	)

	input.AccountNumber = strings.TrimSpace(
		input.AccountNumber,
	)

	if input.BankCode == "" {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "bank_code is required",
		})
		return
	}

	if len(input.AccountNumber) != 10 {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "account number must contain 10 digits",
		})
		return
	}

	if input.AmountKobo <= 0 {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "amount_kobo must be greater than zero",
		})
		return
	}

	maxSingle := envInt64(
		"MAX_SINGLE_TRANSFER_KOBO",
		5_000_000,
	)

	if input.AmountKobo > maxSingle {
		c.JSON(http.StatusUnprocessableEntity, gin.H{
			"error": "single transfer limit exceeded",
		})
		return
	}

	idempotencyKey := strings.TrimSpace(
		c.GetHeader("Idempotency-Key"),
	)

	if idempotencyKey == "" {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "Idempotency-Key header required",
		})
		return
	}

	// Resolve the account first.
	query := url.Values{}

	query.Set(
		"account_number",
		input.AccountNumber,
	)

	query.Set(
		"bank_code",
		input.BankCode,
	)

	resolved, _, err := a.paystackRequest(
		c.Request.Context(),
		http.MethodGet,
		"/bank/resolve?"+query.Encode(),
		nil,
	)

	if err != nil {
		c.JSON(
			http.StatusUnprocessableEntity,
			gin.H{
				"error":
					"account resolution failed",
				"provider": resolved,
			},
		)
		return
	}

	data, ok := resolved["data"].(map[string]any)

	if !ok {
		c.JSON(http.StatusUnprocessableEntity, gin.H{
			"error": "provider returned invalid account data",
		})
		return
	}

	accountName, ok := data["account_name"].(string)

	if !ok || strings.TrimSpace(accountName) == "" {
		c.JSON(http.StatusUnprocessableEntity, gin.H{
			"error": "provider did not return account name",
		})
		return
	}

	accountName = strings.TrimSpace(accountName)

	// Hash the actual server-verified request.
	hashInput := fmt.Sprintf(
		"%s|%s|%s|%d|%s",
		input.BankCode,
		input.AccountNumber,
		accountName,
		input.AmountKobo,
		input.Reason,
	)

	hash := sha256.Sum256(
		[]byte(hashInput),
	)

	requestHash := hex.EncodeToString(
		hash[:],
	)

	tx, err := a.db.Begin(
		c.Request.Context(),
	)

	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "database transaction failed",
		})
		return
	}

	defer tx.Rollback(
		c.Request.Context(),
	)

	// Idempotency check.
	var (
		oldHash string
		oldCode int
		oldBody []byte
	)

	err = tx.QueryRow(
		c.Request.Context(),
		`
		SELECT
			request_hash,
			response_code,
			response_body
		FROM idempotency_keys
		WHERE user_id=$1
		  AND key=$2
		`,
		userID,
		idempotencyKey,
	).Scan(
		&oldHash,
		&oldCode,
		&oldBody,
	)

	if err == nil {
		if oldHash != requestHash {
			c.JSON(http.StatusConflict, gin.H{
				"error":
					"Idempotency-Key already used with different request",
			})
			return
		}

		c.Data(
			oldCode,
			"application/json",
			oldBody,
		)

		return
	}

	if !errors.Is(err, pgx.ErrNoRows) {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "idempotency lookup failed",
		})
		return
	}

	// Lock this user's day to prevent concurrent requests
	// bypassing the daily limit.
	_, err = tx.Exec(
		c.Request.Context(),
		`
		SELECT pg_advisory_xact_lock(
			hashtext($1)
		)
		`,
		userID.String()+"|"+
			time.Now().UTC().Format("2006-01-02"),
	)

	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "daily limit lock failed",
		})
		return
	}

	var available int64

	err = tx.QueryRow(
		c.Request.Context(),
		`
		SELECT available_kobo
		FROM wallets
		WHERE user_id=$1
		FOR UPDATE
		`,
		userID,
	).Scan(&available)

	if err != nil {
		c.JSON(http.StatusNotFound, gin.H{
			"error": "wallet not found",
		})
		return
	}

	var todayTotal int64

	err = tx.QueryRow(
		c.Request.Context(),
		`
		SELECT COALESCE(
			SUM(amount_kobo),
			0
		)
		FROM payouts
		WHERE user_id=$1
		  AND created_at >= date_trunc(
		      'day',
		      now()
		  )
		  AND status NOT IN (
		      'FAILED',
		      'REVERSED'
		  )
		`,
		userID,
	).Scan(&todayTotal)

	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "daily limit calculation failed",
		})
		return
	}

	dailyLimit := envInt64(
		"DAILY_TRANSFER_LIMIT_KOBO",
		5_000_000_000,
	)

	if todayTotal+input.AmountKobo > dailyLimit {
		c.JSON(
			http.StatusUnprocessableEntity,
			gin.H{
				"error":
					"daily transfer limit exceeded",
			},
		)
		return
	}

	if available < input.AmountKobo {
		c.JSON(
			http.StatusUnprocessableEntity,
			gin.H{
				"error":
					"insufficient available balance",
			},
		)
		return
	}

	reference :=
		"kubpay-" +
			strings.ReplaceAll(
				uuid.NewString(),
				"-",
				"",
			)

	approvalStatus := "NOT_REQUIRED"
	status := "PROCESSING"

	if strings.EqualFold(
		env(
			"PAYOUT_REQUIRE_APPROVAL",
			"true",
		),
		"true",
	) {
		approvalStatus = "PENDING"
		status = "PENDING_APPROVAL"
	}

	// Reserve customer funds.
	_, err = tx.Exec(
		c.Request.Context(),
		`
		UPDATE wallets
		SET
			available_kobo =
				available_kobo - $1,
			reserved_kobo =
				reserved_kobo + $1,
			updated_at = now()
		WHERE user_id=$2
		  AND available_kobo >= $1
		`,
		input.AmountKobo,
		userID,
	)

	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "fund reservation failed",
		})
		return
	}

	var payoutID uuid.UUID

	err = tx.QueryRow(
		c.Request.Context(),
		`
		INSERT INTO payouts (
			user_id,
			reference,
			account_number,
			bank_code,
			account_name,
			amount_kobo,
			status,
			approval_status
		)
		VALUES (
			$1,$2,$3,$4,$5,$6,$7,$8
		)
		RETURNING id
		`,
		userID,
		reference,
		input.AccountNumber,
		input.BankCode,
		accountName,
		input.AmountKobo,
		status,
		approvalStatus,
	).Scan(&payoutID)

	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "payout creation failed",
		})
		return
	}

	response := gin.H{
		"id":             payoutID,
		"reference":      reference,
		"status":         status,
		"approval_status": approvalStatus,
		"account_name":   accountName,
		"amount_kobo":    input.AmountKobo,
		"currency":       "NGN",
	}

	responseBody, err := json.Marshal(response)

	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "response creation failed",
		})
		return
	}

	_, err = tx.Exec(
		c.Request.Context(),
		`
		INSERT INTO idempotency_keys (
			user_id,
			key,
			request_hash,
			response_code,
			response_body
		)
		VALUES ($1,$2,$3,$4,$5)
		`,
		userID,
		idempotencyKey,
		requestHash,
		http.StatusCreated,
		responseBody,
	)

	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "idempotency record failed",
		})
		return
	}

	_, _ = tx.Exec(
		c.Request.Context(),
		`
		INSERT INTO audit_logs (
			actor_user_id,
			action,
			entity_type,
			entity_id,
			details
		)
		VALUES (
			$1,
			'payout.created',
			'payout',
			$2,
			$3
		)
		`,
		userID,
		payoutID.String(),
		responseBody,
	)

	if err := tx.Commit(
		c.Request.Context(),
	); err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "database commit failed",
		})
		return
	}

	// Only execute immediately when approval is not required.
	if status == "PROCESSING" {
		if err := a.executePayout(
			c.Request.Context(),
			payoutID,
		); err != nil {
			log.Printf(
				"payout execution returned: %v",
				err,
			)
		}
	}

	c.Data(
		http.StatusCreated,
		"application/json",
		responseBody,
	)
}

// ------------------------------------------------------------
// Execute Paystack transfer
// ------------------------------------------------------------

func (a *App) executePayout(
	ctx context.Context,
	payoutID uuid.UUID,
) error {

	tx, err := a.db.Begin(ctx)

	if err != nil {
		return err
	}

	defer tx.Rollback(ctx)

	var (
		reference     string
		accountNumber string
		bankCode      string
		accountName   string
		amount        int64
		status        string
	)

	err = tx.QueryRow(
		ctx,
		`
		SELECT
			reference,
			account_number,
			bank_code,
			account_name,
			amount_kobo,
			status
		FROM payouts
		WHERE id=$1
		FOR UPDATE
		`,
		payoutID,
	).Scan(
		&reference,
		&accountNumber,
		&bankCode,
		&accountName,
		&amount,
		&status,
	)

	if err != nil {
		return err
	}

	if status != "PROCESSING" {
		return nil
	}

	// Create Paystack transfer recipient.
	recipientResponse, _, err :=
		a.paystackRequest(
			ctx,
			http.MethodPost,
			"/transferrecipient",
			map[string]any{
				"type":           "nuban",
				"name":           accountName,
				"account_number": accountNumber,
				"bank_code":      bankCode,
				"currency":       "NGN",
			},
		)

	if err != nil {
		// We don't know whether the provider accepted
		// anything. Keep funds reserved and mark UNKNOWN.
		_, _ = tx.Exec(
			ctx,
			`
			UPDATE payouts
			SET
				status='UNKNOWN',
				failure_reason=$1,
				updated_at=now()
			WHERE id=$2
			`,
			err.Error(),
			payoutID,
		)

		_ = tx.Commit(ctx)

		return err
	}

	recipientData, ok :=
		recipientResponse["data"].(map[string]any)

	if !ok {
		return errors.New(
			"paystack recipient response missing data",
		)
	}

	recipientCode, ok :=
		recipientData["recipient_code"].(string)

	if !ok || recipientCode == "" {
		return errors.New(
			"paystack recipient_code missing",
		)
	}

	// Initiate transfer.
	transferResponse, _, err :=
		a.paystackRequest(
			ctx,
			http.MethodPost,
			"/transfer",
			map[string]any{
				"source":    "balance",
				"amount":    amount,
				"recipient": recipientCode,
				"reference": reference,
				"reason":    nonEmptyReason("KubPay transfer"),
				"currency":  "NGN",
			},
		)

	if err != nil {
		_, _ = tx.Exec(
			ctx,
			`
			UPDATE payouts
			SET
				recipient_code=$1,
				status='UNKNOWN',
				provider_response=$2,
				failure_reason=$3,
				updated_at=now()
			WHERE id=$4
			`,
			recipientCode,
			mustJSON(transferResponse),
			err.Error(),
			payoutID,
		)

		_ = tx.Commit(ctx)

		return err
	}

	providerStatus :=
		providerTransferStatus(
			transferResponse,
		)

	_, err = tx.Exec(
		ctx,
		`
		UPDATE payouts
		SET
			recipient_code=$1,
			status='PROCESSING',
			provider_status=$2,
			provider_response=$3,
			updated_at=now()
		WHERE id=$4
		`,
		recipientCode,
		providerStatus,
		mustJSON(transferResponse),
		payoutID,
	)

	if err != nil {
		return err
	}

	_, _ = tx.Exec(
		ctx,
		`
		INSERT INTO audit_logs (
			action,
			entity_type,
			entity_id,
			details
		)
		VALUES (
			'payout.provider_submitted',
			'payout',
			$1,
			$2
		)
		`,
		payoutID.String(),
		mustJSON(transferResponse),
	)

	return tx.Commit(ctx)
}

