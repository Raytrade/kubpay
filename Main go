func (a *App) approvePayout(c *gin.Context) {
	payoutID, err := uuid.Parse(
		c.Param("id"),
	)

	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "invalid payout id",
		})
		return
	}

	tx, err := a.db.Begin(
		c.Request.Context(),
	)

	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "database error",
		})
		return
	}

	defer tx.Rollback(
		c.Request.Context(),
	)

	var status string

	err = tx.QueryRow(
		c.Request.Context(),
		`
		SELECT status
		FROM payouts
		WHERE id=$1
		FOR UPDATE
		`,
		payoutID,
	).Scan(&status)

	if err != nil {
		c.JSON(http.StatusNotFound, gin.H{
			"error": "payout not found",
		})
		return
	}

	if status != "PENDING_APPROVAL" {
		c.JSON(http.StatusConflict, gin.H{
			"error": "payout is not awaiting approval",
		})
		return
	}

	_, err = tx.Exec(
		c.Request.Context(),
		`
		UPDATE payouts
		SET
			approval_status='APPROVED',
			status='PROCESSING',
			updated_at=now()
		WHERE id=$1
		`,
		payoutID,
	)

	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "approval failed",
		})
		return
	}

	actorID, _ := currentUserID(c)

	_, _ = tx.Exec(
		c.Request.Context(),
		`
		INSERT INTO audit_logs (
			actor_user_id,
			action,
			entity_type,
			entity_id
		)
		VALUES (
			$1,
			'payout.approved',
			'payout',
			$2
		)
		`,
		actorID,
		payoutID.String(),
	)

	if err := tx.Commit(
		c.Request.Context(),
	); err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "commit failed",
		})
		return
	}

	if err := a.executePayout(
		c.Request.Context(),
		payoutID,
	); err != nil {
		c.JSON(
			http.StatusAccepted,
			gin.H{
				"status": "PROCESSING",
				"warning":
					"provider execution deferred",
			},
		)
		return
	}

	c.JSON(
		http.StatusOK,
		gin.H{
			"status": "PROCESSING",
		},
	)
}

func (a *App) rejectPayout(c *gin.Context) {
	payoutID, err := uuid.Parse(
		c.Param("id"),
	)

	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{
			"error": "invalid payout id",
		})
		return
	}

	tx, err := a.db.Begin(
		c.Request.Context(),
	)

	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "database error",
		})
		return
	}

	defer tx.Rollback(
		c.Request.Context(),
	)

	var (
		userID uuid.UUID
		amount int64
		status string
	)

	err = tx.QueryRow(
		c.Request.Context(),
		`
		SELECT
			user_id,
			amount_kobo,
			status
		FROM payouts
		WHERE id=$1
		FOR UPDATE
		`,
		payoutID,
	).Scan(
		&userID,
		&amount,
		&status,
	)

	if err != nil {
		c.JSON(http.StatusNotFound, gin.H{
			"error": "payout not found",
		})
		return
	}

	if status != "PENDING_APPROVAL" {
		c.JSON(http.StatusConflict, gin.H{
			"error": "payout is not pending approval",
		})
		return
	}

	_, err = tx.Exec(
		c.Request.Context(),
		`
		UPDATE payouts
		SET
			status='FAILED',
			approval_status='REJECTED',
			failure_reason='rejected by administrator',
			updated_at=now()
		WHERE id=$1
		`,
		payoutID,
	)

	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "rejection failed",
		})
		return
	}

	// Release the reservation.
	_, err = tx.Exec(
		c.Request.Context(),
		`
		UPDATE wallets
		SET
			reserved_kobo =
				reserved_kobo - $1,
			available_kobo =
				available_kobo + $1,
			updated_at=now()
		WHERE user_id=$2
		`,
		amount,
		userID,
	)

	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "fund release failed",
		})
		return
	}

	actorID, _ := currentUserID(c)

	_, _ = tx.Exec(
		c.Request.Context(),
		`
		INSERT INTO audit_logs (
			actor_user_id,
			action,
			entity_type,
			entity_id
		)
		VALUES (
			$1,
			'payout.rejected',
			'payout',
			$2
		)
		`,
		actorID,
		payoutID.String(),
	)

	if err := tx.Commit(
		c.Request.Context(),
	); err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{
			"error": "commit failed",
		})
		return
	}

	c.JSON(
		http.StatusOK,
		gin.H{
			"status": "FAILED",
		},
	)
}

// ------------------------------------------------------------
// Paystack webhook
// ------------------------------------------------------------

func (a *App) paystackWebhook(c *gin.Context) {
	rawBody, err := io.ReadAll(
		io.LimitReader(
			c.Request.Body,
			4<<20,
		),
	)

	if err != nil {
		c.Status(http.StatusBadRequest)
		return
	}

	signature :=
		strings.TrimSpace(
			c.GetHeader(
				"x-paystack-signature",
			),
		)

	expectedMAC := hmac.New(
		sha512.New,
		[]byte(mustEnv("PAYSTACK_SECRET_KEY")),
	)

	_, _ = expectedMAC.Write(rawBody)

	expectedSignature :=
		hex.EncodeToString(
			expectedMAC.Sum(nil),
		)

	if subtle.ConstantTimeCompare(
		[]byte(strings.ToLower(signature)),
		[]byte(strings.ToLower(expectedSignature)),
	) != 1 {
		c.Status(http.StatusUnauthorized)
		return
	}

	var event struct {
		Event string `json:"event"`
		Data  struct {
			Reference string `json:"reference"`
			Status    string `json:"status"`
			Amount    int64  `json:"amount"`
			ID        int64  `json:"id"`
		} `json:"data"`
	}

	if err := json.Unmarshal(
		rawBody,
		&event,
	); err != nil {
		c.Status(http.StatusBadRequest)
		return
	}

	if event.Event != "transfer.success" &&
		event.Event != "transfer.failed" &&
		event.Event != "transfer.reversed" {

		// Valid Paystack event, but not a transfer event
		// handled by KubPay.
		c.Status(http.StatusOK)
		return
	}

	reference := strings.TrimSpace(
		event.Data.Reference,
	)

	if reference == "" {
		c.Status(http.StatusOK)
		return
	}

	eventID := fmt.Sprintf(
		"%s:%s:%d:%d",
		event.Event,
		reference,
		event.Data.ID,
		event.Data.Amount,
	)

	tx, err := a.db.Begin(
		c.Request.Context(),
	)

	if err != nil {
		c.Status(http.StatusInternalServerError)
		return
	}

	defer tx.Rollback(
		c.Request.Context(),
	)

	// Deduplicate webhook delivery.
	var inserted bool

	err = tx.QueryRow(
		c.Request.Context(),
		`
		INSERT INTO webhook_events (
			event_id,
			event_type,
			payload
		)
		VALUES ($1,$2,$3)
		ON CONFLICT (event_id)
		DO NOTHING
		RETURNING true
		`,
		eventID,
		event.Event,
		rawBody,
	).Scan(&inserted)

	if errors.Is(err, pgx.ErrNoRows) {
		// Already processed.
		_ = tx.Commit(
			c.Request.Context(),
		)
		c.Status(http.StatusOK)
		return
	}

	if err != nil {
		c.Status(http.StatusInternalServerError)
		return
	}

	var (
		payoutID uuid.UUID
		userID   uuid.UUID
		amount   int64
		status   string
	)

	err = tx.QueryRow(
		c.Request.Context(),
		`
		SELECT
			id,
			user_id,
			amount_kobo,
			status
		FROM payouts
		WHERE reference=$1
		FOR UPDATE
		`,
		reference,
	).Scan(
		&payoutID,
		&userID,
		&amount,
		&status,
	)

	if errors.Is(err, pgx.ErrNoRows) {
		// Do not fail the webhook simply because the
		// reference isn't one of our payouts.
		_ = tx.Commit(
			c.Request.Context(),
		)

		c.Status(http.StatusOK)
		return
	}

	if err != nil {
		c.Status(http.StatusInternalServerError)
		return
	}

	// Verify provider amount when supplied.
	if event.Data.Amount > 0 &&
		event.Data.Amount != amount {

		_, _ = tx.Exec(
			c.Request.Context(),
			`
			UPDATE payouts
			SET
				status='UNKNOWN',
				failure_reason=$1,
				updated_at=now()
			WHERE id=$2
			`,
			"provider amount does not match payout amount",
			payoutID,
		)

		_ = tx.Commit(
			c.Request.Context(),
		)

		c.Status(http.StatusOK)
		return
	}

	// Never settle an already-final payout twice.
	if status == "SUCCESS" ||
		status == "FAILED" ||
		status == "REVERSED" {

		_ = tx.Commit(
			c.Request.Context(),
		)

		c.Status(http.StatusOK)
		return
	}

	switch event.Event {

	case "transfer.success":

		_, err = tx.Exec(
			c.Request.Context(),
			`
			UPDATE payouts
			SET
				status='SUCCESS',
				provider_status='success',
				provider_response=$1,
				updated_at=now()
			WHERE id=$2
			`,
			rawBody,
			payoutID,
		)

		if err == nil {
			_, err = tx.Exec(
				c.Request.Context(),
				`
				UPDATE wallets
				SET
					reserved_kobo =
						reserved_kobo - $1,
					updated_at=now()
				WHERE user_id=$2
				  AND reserved_kobo >= $1
				`,
				amount,
				userID,
			)
		}

		if err == nil {
			_, err = tx.Exec(
				c.Request.Context(),
				`
				INSERT INTO ledger_entries (
					user_id,
					kind,
					amount_kobo,
					reference
				)
				VALUES (
					$1,
					'PAYOUT_DEBIT',
					$2,
					$3
				)
				`,
				userID,
				-amount,
				reference,
			)
		}

	case "transfer.failed":

		_, err = tx.Exec(
			c.Request.Context(),
			`
			UPDATE payouts
			SET
				status='FAILED',
				provider_status='failed',
				provider_response=$1,
				updated_at=now()
			WHERE id=$2
			`,
			rawBody,
			payoutID,
		)

		if err == nil {
			_, err = tx.Exec(
				c.Request.Context(),
				`
				UPDATE wallets
				SET
					reserved_kobo =
						reserved_kobo - $1,
					available_kobo =
						available_kobo + $1,
					updated_at=now()
				WHERE user_id=$2
				  AND reserved_kobo >= $1
				`,
				amount,
				userID,
			)
		}

	case "transfer.reversed":

		_, err = tx.Exec(
			c.Request.Context(),
			`
			UPDATE payouts
			SET
				status='REVERSED',
				provider_status='reversed',
				provider_response=$1,
				updated_at=now()
			WHERE id=$2
			`,
			rawBody,
			payoutID,
		)

		if err == nil {
			_, err = tx.Exec(
				c.Request.Context(),
				`
				UPDATE wallets
				SET
					reserved_kobo =
						reserved_kobo - $1,
					available_kobo =
						available_kobo + $1,
					updated_at=now()
				WHERE user_id=$2
				  AND reserved_kobo >= $1
				`,
				amount,
				userID,
			)
		}
	}

	if err != nil {
		c.Status(http.StatusInternalServerError)
		return
	}

	_, _ = tx.Exec(
		c.Request.Context(),
		`
		INSERT INTO audit_logs (
			action,
			entity_type,
			entity_id,
			details
		)
		VALUES (
			'payout.webhook_processed',
			'payout',
			$1,
			$2
		)
		`,
		payoutID.String(),
		rawBody,
	)

	if err := tx.Commit(
		c.Request.Context(),
	); err != nil {
		c.Status(http.StatusInternalServerError)
		return
	}

	c.Status(http.StatusOK)
}

