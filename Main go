// ------------------------------------------------------------
// Paystack HTTP client
// ------------------------------------------------------------

func (a *App) paystackRequest(
	ctx context.Context,
	method string,
	path string,
	body any,
) (PaystackResponse, int, error) {

	baseURL := strings.TrimRight(
		env(
			"PAYSTACK_BASE_URL",
			"https://api.paystack.co",
		),
		"/",
	)

	var requestBody io.Reader

	if body != nil {
		raw, err := json.Marshal(body)

		if err != nil {
			return nil, 0, err
		}

		requestBody = bytes.NewReader(raw)
	}

	req, err := http.NewRequestWithContext(
		ctx,
		method,
		baseURL+path,
		requestBody,
	)

	if err != nil {
		return nil, 0, err
	}

	req.Header.Set(
		"Authorization",
		"Bearer "+mustEnv("PAYSTACK_SECRET_KEY"),
	)

	req.Header.Set(
		"Content-Type",
		"application/json",
	)

	client := &http.Client{
		Timeout: 20 * time.Second,
	}

	response, err := client.Do(req)

	if err != nil {
		return nil, 0, err
	}

	defer response.Body.Close()

	raw, err := io.ReadAll(
		io.LimitReader(
			response.Body,
			4<<20,
		),
	)

	if err != nil {
		return nil, response.StatusCode, err
	}

	var result PaystackResponse

	if len(raw) > 0 {
		if err := json.Unmarshal(raw, &result); err != nil {
			return nil,
				response.StatusCode,
				fmt.Errorf(
					"invalid provider response: %s",
					string(raw),
				)
		}
	}

	if response.StatusCode < 200 ||
		response.StatusCode >= 300 {

		return result,
			response.StatusCode,
			fmt.Errorf(
				"paystack returned HTTP %d",
				response.StatusCode,
			)
	}

	ok, _ := result["status"].(bool)

	if !ok {
		return result,
			response.StatusCode,
			errors.New(
				"paystack returned unsuccessful status",
			)
	}

	return result,
		response.StatusCode,
		nil
}

